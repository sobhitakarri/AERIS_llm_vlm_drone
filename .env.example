# Copy this file to ".env" in the SAME folder (Project_phase1/.env).
# The server reads .env. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Tried in order if this model is unavailable:
# gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.7-flash

# Provider selection (options: gemini, qwen)
# These are read by config.py and used by server.py at startup.
LLM_PROVIDER=gemini
VLM_PROVIDER=gemini

# Drone connection (options: sim, real, matlab, pysimverse)
DRONE_BACKEND=sim
